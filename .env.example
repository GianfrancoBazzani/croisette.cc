# Required for agent registration (scripts/register-agent.ts)
PRIVATE_KEY=0x...

# Network: "testnet" or "mainnet" (default: testnet)
NETWORK=testnet

# Storage mode: "turbo" or "standard" (default: turbo)
STORAGE_MODE=turbo

# Optional gas configuration
# GAS_PRICE=
# GAS_LIMIT=
# MAX_RETRIES=
# MAX_GAS_PRICE=
